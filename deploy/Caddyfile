# Caddy obtains and renews the HTTPS certificate for SITE_HOST itself.
# /api goes straight to FastAPI; everything else is the Next.js app. One
# origin, so the refresh cookie stays first-party and SameSite=Lax holds.
{$SITE_HOST} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
